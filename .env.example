# ==============================================================================
# JIPAS SMSys — Production & Staging Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with production secrets and cloud keys.

# ------------------------------------------------------------------------------
# 1. AI & LLM Services (Google Gemini)
# ------------------------------------------------------------------------------
# Required for server-side AI evaluation, report generation, and student diagnostics.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Firebase Cloud Firestore & Authentication (Optional Cloud Backend)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=jipas-school-management.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jipas-school-management
VITE_FIREBASE_STORAGE_BUCKET=jipas-school-management.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 3. Supabase Relational Database & Realtime Sync (Alternative Backend)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 4. Google Workspace & Drive OAuth Integration
# ------------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. SMTP Notification & Email Gateway
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@jipas-smsys.cm
SMTP_PASS=your_app_password_here
SMTP_FROM="JIPAS SMSys Official" <notifications@jipas-smsys.cm>

# ------------------------------------------------------------------------------
# 6. SMS Gateways (Twilio / Orange Cameroon API)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ORANGE_CAMEROON_SMS_AUTH_HEADER=
ORANGE_CAMEROON_SENDER_NAME=JIPAS-SMS

# ------------------------------------------------------------------------------
# 7. Web Application Firewall & Security Settings
# ------------------------------------------------------------------------------
WAF_RATE_LIMIT_WINDOW_MS=900000
WAF_RATE_LIMIT_MAX=200
NODE_ENV=production
